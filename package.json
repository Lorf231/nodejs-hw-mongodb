  },
  "homepage": "https://github.com/Lorf231/nodejs-hw-mongodb#readme",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@redocly/cli": "^2.0.8",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "http-errors": "^2.0.0",
    "joi": "^18.0.0",
